<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    tools:context=".MainActivity">

    <!-- Topo: Voltar e Título "Mapa de Risco" -->

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:rotation="180"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:text="Mapa de Risco"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tag "AO VIVO" -->
    <TextView
        android:id="@+id/tvAoVivo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_tag_red"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="AO VIVO"
        android:textColor="@color/cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle" />

    <!-- 4 Cards de Filtro Superiores (Baixo, Atenção, Alto, Crítico) -->
    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <!-- Filtro Baixo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_filter_card"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baixo" android:textColor="@color/safe" android:textSize="11sp" android:textStyle="bold"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="2dp" android:src="@drawable/ic_logo_abrigo" app:tint="@color/safe"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Abrigos" android:textColor="@color/muted" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Filtro Atenção -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_filter_card"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atenção" android:textColor="@color/attention" android:textSize="11sp" android:textStyle="bold"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="2dp" android:src="@drawable/ic_logo_abrigo" app:tint="@color/attention"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Abrigos" android:textColor="@color/muted" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Filtro Alto -->

        <!-- Filtro Crítico -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_card"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alto"
                android:textColor="@color/attention"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_logo_abrigo"
                app:tint="@color/attention" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Abrigos"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_filter_card"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crítico" android:textColor="@color/critical" android:textSize="11sp" android:textStyle="bold"/>
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="2dp" android:src="@drawable/ic_logo_abrigo" app:tint="@color/critical"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Abrigos" android:textColor="@color/muted" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Área do Mapa Ilustrado -->
    <ImageView
        android:id="@+id/ivMapaIlustracao"
        android:layout_width="388dp"
        android:layout_height="385dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_dark_risk_map"
        app:layout_constraintBottom_toTopOf="@id/cardAbrigoRecomendado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltros" />

    <!-- Card Inferior com Borda Verde (Abrigo Recomendado) -->
    <LinearLayout
        android:id="@+id/cardAbrigoRecomendado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_recommended_card"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABRIGO RECOMENDADO"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Abrigo Municipal Vila Norte"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1,8 km • 120 vagas • atualizado há 3 min"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ menor exposição ao risco • acessível"
            android:textColor="@color/safe"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnVerRotaAbrigo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/electric"
            android:text="Ver rota até o abrigo"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>